@model Midterm_Entprog.Models.Product

@{
    ViewData["Title"] = "Add Product";
}

<h1 class="mb-4">Add Product</h1>

<form asp-action="Create" method="post">

    <div class="mb-3">
        <label class="form-label">Name</label>
        <input asp-for="Name" class="form-control bg-dark text-light border-secondary" />
    </div>

    <div class="mb-3">
        <label class="form-label">Description</label>
        <textarea asp-for="Description"
                  class="form-control bg-dark text-light border-secondary"></textarea>
    </div>

    <div class="mb-3">
        <label class="form-label">Price</label>
        <input asp-for="Price" class="form-control bg-dark text-light border-secondary" />
    </div>

    <div class="mb-3">
        <label class="form-label">Category</label>
        <input asp-for="Category" class="form-control bg-dark text-light border-secondary" />
    </div>

    <button type="submit" class="btn btn-primary">
        Save
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Back
    </a>

</form>